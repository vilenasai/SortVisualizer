<Window x:Class="SortVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SortVisualizer"
        mc:Ignorable="d"
        Title="Портфолио" Height="650" Width="950"
        Background="#FFF8FA"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Заголовок возвращен к исходному цвету -->
    <TextBlock Grid.Row="0"
                   Text="Мои работы"
                   FontSize="26" FontWeight="SemiBold"
                   Foreground="#3D1F2C"
                   Margin="0,0,0,20"/>

    <UniformGrid Grid.Row="1" Rows="3" Columns="3">
      <!-- 1. Сортировки (Исходный стиль) -->
      <Button Content="1. Сортировки"
                    Tag="Sort" Click="OnTileClick"
                    Background="#FCE4EC" Foreground="#C2185B"
                    BorderBrush="#F8BBD0" BorderThickness="2"
                    Margin="8" FontSize="16" FontWeight="SemiBold"
                    Cursor="Hand"/>

      <!-- 2. Дихотомия (Исходный стиль) -->
      <Button Content="2. Дихотомия"
        Tag="Work2" Click="OnTileClick"
        Background="#F3E5F5" Foreground="#7A5C68"
        BorderBrush="#CE93D8" BorderThickness="2"
        Margin="8" FontSize="16"
        Cursor="Hand"/>

      <!-- 3. Золотое сечение (Новый мягкий персиковый стиль с тенью) -->
      <Button Content="3. Золотое сечение"
        Tag="GoldenSection"
        Click="OnTileClick"
        Background="#F5E6D3"
        Foreground="#795548"
        BorderBrush="#E8D1B5"
        BorderThickness="1.5"
        Margin="8"
        FontSize="16"
        FontWeight="SemiBold"
        Cursor="Hand">
        <Button.Effect>
          <DropShadowEffect Color="#E8D1B5" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
        </Button.Effect>
      </Button>

      <!-- 4. Работа 4 (Исходный стиль) -->
      <Button Content="4. Работа 4"
                    Tag="" Click="OnTileClick"
                    Background="#FFF8FA" Foreground="#7A5C68"
                    BorderBrush="#F8BBD0" BorderThickness="2"
                    Margin="8" FontSize="16"
                    Cursor="Hand"/>

      <!-- 5. Работа 5 (Исходный стиль) -->
      <Button Content="5. Работа 5"
                    Tag="" Click="OnTileClick"
                    Background="#FFF8FA" Foreground="#7A5C68"
                    BorderBrush="#F8BBD0" BorderThickness="2"
                    Margin="8" FontSize="16"
                    Cursor="Hand"/>

      <!-- 6. Работа 6 (Исходный стиль) -->
      <Button Content="6. Работа 6"
                    Tag="" Click="OnTileClick"
                    Background="#FFF8FA" Foreground="#7A5C68"
                    BorderBrush="#F8BBD0" BorderThickness="2"
                    Margin="8" FontSize="16"
                    Cursor="Hand"/>

      <!-- 7. Работа 7 (Исходный стиль) -->
      <Button Content="7. Работа 7"
                    Tag="" Click="OnTileClick"
                    Background="#FFF8FA" Foreground="#7A5C68"
                    BorderBrush="#F8BBD0" BorderThickness="2"
                    Margin="8" FontSize="16"
                    Cursor="Hand"/>

      <!-- 8. Работа 8 (Исходный стиль) -->
      <Button Content="8. Работа 8"
                    Tag="" Click="OnTileClick"
                    Background="#FFF8FA" Foreground="#7A5C68"
                    BorderBrush="#F8BBD0" BorderThickness="2"
                    Margin="8" FontSize="16"
                    Cursor="Hand"/>

      <!-- 9. Работа 9 (Исходный стиль) -->
      <Button Content="9. Работа 9"
                    Tag="" Click="OnTileClick"
                    Background="#FFF8FA" Foreground="#7A5C68"
                    BorderBrush="#F8BBD0" BorderThickness="2"
                    Margin="8" FontSize="16"
                    Cursor="Hand"/>
    </UniformGrid>
  </Grid>
</Window>