<Window x:Class="SortVisualizer.Views.DichotomyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SortVisualizer.Views"
        mc:Ignorable="d"
        Title="Метод дихотомии" Height="800" Width="1200"
        Background="#F3E5F5"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <!-- МЕНЮ СВЕРХУ -->
    <Menu DockPanel.Dock="Top" Background="#E1BEE7">
      <MenuItem Header="Файл" Foreground="#4A148C">
        <MenuItem Header="Выход" Click="OnExitClick"/>
      </MenuItem>
      <MenuItem Header="Расчёт" Foreground="#4A148C">
        <MenuItem Header="Рассчитать" Click="OnCalculateClick"/>
        <MenuItem Header="Очистить" Click="OnClearClick"/>
      </MenuItem>
    </Menu>

    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ПАРАМЕТРЫ -->
      <Border Grid.Row="0"
                    Background="#FFFFFF" CornerRadius="8"
                    BorderBrush="#CE93D8" BorderThickness="1"
                    Padding="12" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="a ="
                               VerticalAlignment="Center"
                               Foreground="#4A148C" Margin="0,0,6,0"/>
          <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="TxtA" Text="0"
                             Padding="4" Margin="0,0,0,6"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

          <TextBlock Grid.Row="0" Grid.Column="3" Text="b ="
                               VerticalAlignment="Center"
                               Foreground="#4A148C" Margin="0,0,6,0"/>
          <TextBox Grid.Row="0" Grid.Column="4"
                             x:Name="TxtB" Text="5"
                             Padding="4" Margin="0,0,0,6"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="e ="
                               VerticalAlignment="Center"
                               Foreground="#4A148C" Margin="0,0,6,0"/>
          <TextBox Grid.Row="1" Grid.Column="1"
                             x:Name="TxtE" Text="0.001"
                             Padding="4" Margin="0,0,0,0"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

          <TextBlock Grid.Row="1" Grid.Column="3" Text="f(x) ="
                               VerticalAlignment="Center"
                               Foreground="#4A148C" Margin="0,0,6,0"/>
          <TextBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                             x:Name="TxtFunction" Text="x*x - 4*x + 3"
                             Padding="4" Margin="0,0,0,0"/>
        </Grid>
      </Border>

      <!-- ГРАФИК -->
      <Border Grid.Row="1"
                    Background="#FFFFFF" CornerRadius="8"
                    BorderBrush="#CE93D8" BorderThickness="1"
                    Padding="10" Margin="0,0,0,10">
        <Canvas x:Name="GraphCanvas"
                        Background="#FFFFFF"
                        ClipToBounds="True"/>
      </Border>

      <!-- РЕЗУЛЬТАТЫ -->
      <Border Grid.Row="2"
                    Background="#FFFFFF" CornerRadius="8"
                    BorderBrush="#CE93D8" BorderThickness="1"
                    Padding="12">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="x_min = "
                               FontWeight="SemiBold" Foreground="#7B1FA2"/>
          <TextBlock x:Name="TxtXMin" Text="—"
                               Foreground="#7B1FA2" FontWeight="SemiBold"
                               Margin="0,0,30,0"/>

          <TextBlock Text="f(x_min) = "
                               FontWeight="SemiBold" Foreground="#7B1FA2"/>
          <TextBlock x:Name="TxtFMin" Text="—"
                               Foreground="#7B1FA2" FontWeight="SemiBold"
                               Margin="0,0,30,0"/>

          <TextBlock Text="Итераций: "
                               FontWeight="SemiBold" Foreground="#7B1FA2"/>
          <TextBlock x:Name="TxtIterations" Text="—"
                               Foreground="#7B1FA2" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>