<Window x:Class="SortVisualizer.Views.DichotomyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Метод дихотомии — поиск корня"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="800"
        Background="#F3E5F5"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <Menu DockPanel.Dock="Top"
              Background="#E1BEE7">

      <MenuItem Header="Файл"
                      Foreground="#4A148C">
        <MenuItem Header="Выход"
                          Click="OnExitClick"/>
      </MenuItem>

      <MenuItem Header="Расчёт"
                      Foreground="#4A148C">
        <MenuItem Header="Рассчитать корень"
                          Click="OnCalculateRootClick"/>
        <MenuItem Header="Построить график"
                          Click="OnDrawGraphClick"/>
        <Separator/>
        <MenuItem Header="Очистить"
                          Click="OnClearClick"/>
      </MenuItem>
    </Menu>

    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Поля ввода -->
      <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#CE93D8"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,10">

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="a ="
                               VerticalAlignment="Center"
                               Foreground="#4A148C"
                               Margin="0,0,6,0"/>

          <TextBox x:Name="TxtA"
                             Grid.Row="0"
                             Grid.Column="1"
                             Text="0"
                             Padding="4"
                             Margin="0,0,0,6"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

          <TextBlock Grid.Row="0"
                               Grid.Column="3"
                               Text="b ="
                               VerticalAlignment="Center"
                               Foreground="#4A148C"
                               Margin="0,0,6,0"/>

          <TextBox x:Name="TxtB"
                             Grid.Row="0"
                             Grid.Column="4"
                             Text="3"
                             Padding="4"
                             Margin="0,0,0,6"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

          <TextBlock Grid.Row="0"
                               Grid.Column="6"
                               Text="ε ="
                               VerticalAlignment="Center"
                               Foreground="#4A148C"
                               Margin="0,0,6,0"/>

          <TextBox x:Name="TxtE"
                             Grid.Row="0"
                             Grid.Column="7"
                             Text="0.001"
                             Padding="4"
                             Margin="0,0,0,6"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

          <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="f(x) ="
                               VerticalAlignment="Center"
                               Foreground="#4A148C"
                               Margin="0,0,6,0"/>

          <TextBox x:Name="TxtFunction"
                             Grid.Row="1"
                             Grid.Column="1"
                             Grid.ColumnSpan="10"
                             Text="x*x-4"
                             Padding="4"/>
        </Grid>
      </Border>

      <!-- График -->
      <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#CE93D8"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,10">

        <Canvas x:Name="GraphCanvas"
                        Background="White"
                        ClipToBounds="True"
                        SizeChanged="GraphCanvas_SizeChanged"/>
      </Border>

      <!-- Результат -->
      <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#CE93D8"
                    BorderThickness="1"
                    Padding="12"
                    MaxHeight="110">

        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Корень x = "
                                   FontWeight="SemiBold"
                                   Foreground="#7B1FA2"/>

            <TextBlock x:Name="TxtRoot"
                                   Text="—"
                                   Foreground="#7B1FA2"
                                   FontWeight="SemiBold"/>
          </StackPanel>

          <TextBlock x:Name="TxtFValue"
                               Text=""
                               Foreground="#7B1FA2"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>