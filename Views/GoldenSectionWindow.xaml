<Window x:Class="SortVisualizer.Views.GoldenSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Метод золотого сечения"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="800"
        Background="#FCFAFA" 
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <!-- Меню: нежно-персиковый фон, мягкий текст -->
    <Menu DockPanel.Dock="Top" Background="#F5E6D3">
      <MenuItem Header="Файл" Foreground="#5D4037">
        <MenuItem Header="Открыть файл..." Click="OnOpenFileClick"/>
        <Separator/>
        <MenuItem Header="Выход" Click="OnExitClick"/>
      </MenuItem>

      <MenuItem Header="Расчёт" Foreground="#5D4037">
        <MenuItem Header="Найти экстремум" Click="OnFindExtremumClick"/>
        <MenuItem Header="Построить график" Click="OnDrawGraphClick"/>
        <Separator/>
        <MenuItem Header="Очистить" Click="OnClearClick"/>
      </MenuItem>
    </Menu>

    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Параметры: белый фон, мягкая персиковая рамка -->
      <Border Grid.Row="0" Background="White" CornerRadius="10"
                    BorderBrush="#E8D1B5" BorderThickness="1"
                    Padding="16" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="150"/>
          </Grid.ColumnDefinitions>

          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="a ="
                               VerticalAlignment="Center"
                               Foreground="#6D4C41" Margin="0,0,6,8"/>
          <TextBox x:Name="TxtA" Grid.Row="0" Grid.Column="1"
                             Text="-2" Padding="6" Margin="0,0,0,8"
                             BorderBrush="#E0E0E0"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

          <TextBlock Grid.Row="0" Grid.Column="3" Text="b ="
                               VerticalAlignment="Center"
                               Foreground="#6D4C41" Margin="0,0,6,8"/>
          <TextBox x:Name="TxtB" Grid.Row="0" Grid.Column="4"
                             Text="3" Padding="6" Margin="0,0,0,8"
                             BorderBrush="#E0E0E0"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

          <TextBlock Grid.Row="0" Grid.Column="6" Text="ε ="
                               VerticalAlignment="Center"
                               Foreground="#6D4C41" Margin="0,0,6,8"/>
          <TextBox x:Name="TxtE" Grid.Row="0" Grid.Column="7"
                             Text="0.001" Padding="6" Margin="0,0,0,8"
                             BorderBrush="#E0E0E0"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

          <TextBlock Grid.Row="0" Grid.Column="9" Text="Искать:"
                               VerticalAlignment="Center"
                               Foreground="#6D4C41" Margin="0,0,6,8"/>
          <ComboBox x:Name="ModeCombo" Grid.Row="0" Grid.Column="10"
                              SelectedIndex="0" Padding="6" Margin="0,0,0,8"
                              BorderBrush="#E0E0E0">
            <ComboBoxItem Content="Минимум"/>
            <ComboBoxItem Content="Максимум"/>
            <ComboBoxItem Content="Корень f(x)=0"/>
            <!-- ДОБАВЛЕН ТРЕТИЙ ПУНКТ -->
          </ComboBox>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="f(x) ="
                               VerticalAlignment="Center"
                               Foreground="#6D4C41" Margin="0,0,6,0"/>
          <TextBox x:Name="TxtFunction" Grid.Row="1" Grid.Column="1"
                             Grid.ColumnSpan="10"
                             Text="(x-1)*(x-1)+2" Padding="6"
                             BorderBrush="#E0E0E0"/>
        </Grid>
      </Border>

      <!-- График: мягкая рамка, белый фон -->
      <Border Grid.Row="1" Background="White" CornerRadius="10"
                    BorderBrush="#E8D1B5" BorderThickness="1"
                    Padding="10" Margin="0,0,0,12">
        <Canvas x:Name="GraphCanvas" Background="White"
                        ClipToBounds="True" SizeChanged="GraphCanvas_SizeChanged"/>
      </Border>

      <!-- Результат: белый фон, нежная рамка -->
      <Border Grid.Row="2" Background="White" CornerRadius="10"
                    BorderBrush="#E8D1B5" BorderThickness="1"
                    Padding="16" MaxHeight="100">
        <StackPanel>
          <TextBlock x:Name="TxtResult"
                               Text="Введите функцию и нажмите «Найти»."
                               Foreground="#5D4037" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
          <TextBlock x:Name="TxtFunctionValue" Text=""
                               Foreground="#8D6E63" FontFamily="Consolas"
                               FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>