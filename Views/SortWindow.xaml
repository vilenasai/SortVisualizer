<Window x:Class="SortVisualizer.Views.SortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SortVisualizer"
        mc:Ignorable="d"
        Title="Визуализатор сортировок" Height="900" Width="1400"
        Background="#FFF8FA"
        FontFamily="Segoe UI" FontSize="13">

  <DockPanel>
    <!-- МЕНЮ СВЕРХУ -->
    <Menu DockPanel.Dock="Top" Background="#FFE0EC">
      <MenuItem Header="Файл" Foreground="#3D1F2C">
        <MenuItem Header="Загрузить из Excel…"
                          Click="OnLoadExcelClick"/>
        <MenuItem Header="Загрузить из Google Table…"
                          Click="OnLoadGoogleClick"/>
        <Separator/>
        <MenuItem Header="Выход" Click="OnExitClick"/>
      </MenuItem>
    </Menu>

    <!-- ОСНОВНАЯ ОБЛАСТЬ -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ЛЕВАЯ КОЛОНКА -->
      <Border Grid.Column="0" Background="#FFE0EC"
                    BorderBrush="#FFD1E0" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                               Text="Сортировки"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="#3D1F2C"
                               Margin="20,20,20,10"/>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
            <ItemsControl x:Name="AlgorithmList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,4" Padding="12"
                                            CornerRadius="8"
                                            BorderThickness="2"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="OnAlgorithmCardClick">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFF8FA"/>
                        <Setter Property="BorderBrush" Value="#F8BBD0"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="#FCE4EC"/>
                            <Setter Property="BorderBrush" Value="#E91E63"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0">
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="Fill" Value="#BDBDBD"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="Fill" Value="#E91E63"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Foreground="#3D1F2C"
                                                           VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Foreground="#7A5C68"
                                                       Margin="20,6,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ПРАВАЯ ОБЛАСТЬ -->
      <Grid Grid.Column="1" Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="2*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="1*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поле массива -->
        <Border Grid.Row="0"
                        Background="#FFFFFF" CornerRadius="8"
                        BorderBrush="#F8BBD0" BorderThickness="1"
                        Padding="10" Margin="0,0,0,10">
          <TextBox x:Name="TxtArray"
                             Text="m = []"
                             FontFamily="Consolas" FontSize="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="70" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#3D1F2C"/>
        </Border>

        <!-- Направление + генерация + кнопки -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <RadioButton x:Name="RbAsc" Content="↑ По возрастанию"
                                     GroupName="Direction"
                                     IsChecked="True" Margin="0,0,10,0"
                                     Foreground="#3D1F2C"/>
            <RadioButton x:Name="RbDesc" Content="↓ По убыванию"
                                     GroupName="Direction"
                                     Margin="0,0,20,0"
                                     Foreground="#3D1F2C"/>

            <Rectangle Width="1" Fill="#F8BBD0" Margin="0,4,20,4"/>

            <RadioButton x:Name="RbAverage" Content="Среднее"
                                     GroupName="Generation"
                                     IsChecked="True" Margin="0,0,10,0"
                                     Foreground="#3D1F2C"/>
            <RadioButton x:Name="RbTable" Content="Табличная"
                                     GroupName="Generation"
                                     Margin="0,0,10,0"
                                     Foreground="#3D1F2C"/>
            <RadioButton x:Name="RbManual" Content="Ручной"
                                     GroupName="Generation"
                                     Foreground="#3D1F2C"/>
          </StackPanel>

          <Button Grid.Column="2"
                            x:Name="BtnGenerate"
                            Content="🎲 Сгенерировать"
                            Padding="16,8" Margin="0,0,8,0"
                            Background="#FCE4EC" Foreground="#C2185B"
                            BorderBrush="#F8BBD0" BorderThickness="1"
                            Cursor="Hand"
                            Click="OnGenerateClick"/>

          <Button Grid.Column="3"
                            x:Name="BtnSort"
                            Content="СОРТИРОВАТЬ"
                            Padding="20,8"
                            Background="#E91E63" Foreground="White"
                            BorderBrush="#E91E63" BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OnSortClick"/>
        </Grid>

        <!-- Таблица результатов -->
        <Border Grid.Row="2"
                        Background="#FFFFFF" CornerRadius="8"
                        BorderBrush="#F8BBD0" BorderThickness="1">
          <DataGrid x:Name="ResultsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              IsHitTestVisible="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FFF8FA"
                              BorderThickness="0"
                              HorizontalGridLinesBrush="#F5E0E8">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFastest}" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Алгоритм"
                                                Binding="{Binding AlgorithmName}"
                                                Width="180"/>
              <DataGridTemplateColumn Header="Отсортированный список" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding SortedArrayText}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   VerticalAlignment="Top"
                                                   Margin="4,4"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Время (мс)"
                                                Binding="{Binding TimeMs, StringFormat=F2}"
                                                Width="100"/>
              <DataGridTextColumn Header="Итерации"
                                                Binding="{Binding Iterations, StringFormat=F2}"
                                                Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- Заголовок пиковых -->
        <TextBlock Grid.Row="3"
                           Text="Пиковые значения"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#3D1F2C"
                           Margin="0,12,0,6"/>

        <!-- Таблица пиковых -->
        <Border Grid.Row="4"
                        Background="#FFFFFF" CornerRadius="8"
                        BorderBrush="#F8BBD0" BorderThickness="1">
          <DataGrid x:Name="PeaksGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              IsHitTestVisible="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FFF8FA"
                              BorderThickness="0"
                              HorizontalGridLinesBrush="#F5E0E8">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFastest}" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Алгоритм"
                                                Binding="{Binding AlgorithmName}"
                                                Width="180"/>
              <DataGridTextColumn Header="Направление"
                                                Binding="{Binding Direction}"
                                                Width="120"/>
              <DataGridTextColumn Header="Время (мс)"
                                                Binding="{Binding TimeMs, StringFormat=F2}"
                                                Width="100"/>
              <DataGridTextColumn Header="Итерации"
                                                Binding="{Binding Iterations, StringFormat=F2}"
                                                Width="100"/>
              <DataGridTextColumn Header="Итераций/мс (пик)"
                                                Binding="{Binding IterationsPerMs, StringFormat=F2}"
                                                Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- Кнопка отмены -->
        <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
          <Button x:Name="BtnCancel"
                            Content="ОТМЕНИТЬ ВСЕ СОРТИРОВКИ"
                            Padding="20,8"
                            Background="#D81B60" Foreground="White"
                            BorderBrush="#D81B60" BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OnCancelClick"/>
        </StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>